# Supabase – wartości w .env (lokalnie) lub w GitHub: Settings → Secrets and variables → Actions
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Reference ID projektu (Dashboard → Settings → General) – do generowania typów: npm run gen:supabase-types
SUPABASE_PROJECT_ID=
# Opcjonalnie: token po supabase login (Settings → Access Tokens) – potrzebny do gen:supabase-types na zdalnym projekcie
# SUPABASE_ACCESS_TOKEN=  # wklej token z Account → Access Tokens (do gen:supabase-types)