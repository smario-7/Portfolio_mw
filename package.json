{
  "name": "portfolio-mw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && ANALYZE=true vite build",
    "preview": "vite preview",
    "lint": "eslint \"src\" \"e2e\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test -c playwright.auth.config.ts --headed",
    "gen:supabase-types": "dotenv -e .env -- npx supabase gen types typescript --project-id ${SUPABASE_PROJECT_ID} --schema public > src/lib/supabase/database.types.ts",
    "knip": "knip"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@supabase/supabase-js": "^2.95.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "^0.454.0",
    "next-themes": "^0.4.6",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-ipynb-renderer": "^2.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.0",
    "recharts": "2.15.4",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.1.9",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.5.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.0.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.5",
    "rollup-plugin-visualizer": "^7.0.0",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "1.3.3",
    "typescript": "~5.7",
    "typescript-eslint": "^8.56.0",
    "vite": "^6.3.5",
    "vitest": "^2.1.8",
    "knip": "^5.0.0"
  }
}
